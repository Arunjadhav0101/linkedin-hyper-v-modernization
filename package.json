{
  "name": "linkedin-hyper-v",
  "version": "2.0.0",
  "description": "LinkedIn Hyper-V Python Automation & Control Plane Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "python -m pytest backend/tests -v",
    "backend:dev": "uvicorn backend.app.main:app --reload --port 8080",
    "frontend:dev": "npm run dev --workspace=frontend",
    "prisma:generate": "prisma generate --schema=database/schema.prisma",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,py}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "prettier": "^3.2.5",
    "prisma": "^5.10.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
