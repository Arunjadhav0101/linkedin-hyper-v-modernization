# Application Environment Configuration Blueprint

# Node Environment
NODE_ENV=production
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/linkedin_hyper_v?schema=public"

# Redis Broker & Token Bucket Store
REDIS_URL="redis://localhost:6379"

# Ports & Internal Services
PORT=3000
HEALTH_PORT=8080

# Secrets & Encryption Keys (Inject via Vault / Nomad secrets)
SESSION_SECRET="your-super-secure-random-session-secret"
COOKIE_ENCRYPTION_KEY="32-character-encryption-key-here"

# Dynamic Proxy Defaults
DEFAULT_PROXY_PROTOCOL="HTTP"
PROXY_HEALTH_CHECK_INTERVAL_MS=30000
